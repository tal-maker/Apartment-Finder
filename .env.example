# Copy to .env (never commit it) or set these in the hosting environment.

PORT=3000
# Protect the web app with a password (recommended when it's on the internet).
APP_USER=
APP_PASSWORD=
# Public address of the app, added to "more matches" WhatsApp messages.
PUBLIC_URL=

SCAN_INTERVAL_MINUTES=5
# Max WhatsApp alerts per scan; the rest are summarized in one message.
MAX_ALERTS_PER_SCAN=10
# 1 = also alert on everything found by the very first scan of a source.
NOTIFY_ON_FIRST_SCAN=0

# ---- Alerts: telegram | callmebot | twilio | meta | console
NOTIFY_PROVIDER=telegram
# Telegram bot (free): create a bot with @BotFather, put the token here,
# then run `npm run telegram:bot-setup` to get your chat id.
TELEGRAM_BOT_TOKEN=
TELEGRAM_ALERT_CHAT_IDS=

# WhatsApp alternatives
# CallMeBot (free, personal): "phone:apikey", comma-separated for several people.
CALLMEBOT_RECIPIENTS=972501234567:123456
# Twilio
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=+14155238886
TWILIO_WHATSAPP_TO=+972501234567
# Meta WhatsApp Cloud API
META_WA_TOKEN=
META_WA_PHONE_NUMBER_ID=
META_WA_TO=972501234567
# Approved template with one body variable, needed outside the 24h service window.
META_WA_TEMPLATE=
META_WA_TEMPLATE_LANG=he

# ---- Yad2
YAD2_PAGES=2
YAD2_MAX_DETAILS=20
# Empty = automatic: plain requests first, a browser once Yad2 shows a captcha.
# 1 = always use the browser, 0 = never.
YAD2_USE_BROWSER=
# Browser for Yad2/Facebook: msedge (default on Windows), chrome, or empty for Playwright's Chromium.
# BROWSER_CHANNEL=msedge
# 0 = show the browser window during scans (helps if the captcha keeps coming back).
# BROWSER_HEADLESS=0

# ---- Telegram. Without these, only public channels are read (via t.me/s/...).
# Get API id/hash at https://my.telegram.org/apps, then: npm run telegram:login
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
TELEGRAM_SESSION=

# ---- Facebook: stop the app and run `npm run facebook:login` once to log in.
FACEBOOK_SCROLLS=3
# CHROMIUM_PATH=/usr/bin/chromium

# ---- Optional: Claude reads Facebook/Telegram posts for better extraction.
ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-opus-5-5
